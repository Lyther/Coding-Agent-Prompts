{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-surface asset category",
  "type": "object",
  "required": [
    "category",
    "skills",
    "commands",
    "services"
  ],
  "properties": {
    "category": {
      "enum": [
        "cybersecurity",
        "private",
        "modding"
      ]
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "services": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    }
  },
  "additionalProperties": false
}
